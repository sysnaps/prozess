{
    "body": {
        "style": {
            "width": 16,
            "height": 16,
            "border": "1px solid var(--border)",
            "borderRadius": 3,
            "background": "var(--bg-secondary)",
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "center",
            "fontSize": 11,
            "color": "var(--text-primary)",
            "flexShrink": 0
        }
    }
}