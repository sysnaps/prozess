{
    "body": {
        "style": {
            "padding": "4px 12px",
            "background": "transparent",
            "color": "var(--accent)",
            "border": "none",
            "borderBottom": "2px solid var(--accent)",
            "cursor": "pointer",
            "fontSize": "12px",
            "fontWeight": 600,
            "transition": "color 0.15s, border-color 0.15s",
            "whiteSpace": "nowrap"
        }
    }
}