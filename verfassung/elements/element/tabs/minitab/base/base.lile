{
    "body": {
        "style": {
            "padding": "2px 8px",
            "background": "var(--bg-secondary)",
            "color": "var(--text-secondary)",
            "border": "1px solid var(--border)",
            "borderBottom": "1px solid var(--border)",
            "borderRadius": "3px 3px 0 0",
            "cursor": "pointer",
            "fontSize": "10px",
            "fontWeight": 500,
            "transition": "background 0.1s, color 0.1s",
            "whiteSpace": "nowrap",
            "marginBottom": -1,
            "position": "relative"
        }
    }
}