{
    "body": {
        "style": {
            "padding": "6px 20px",
            "borderRadius": 6,
            "fontSize": 12,
            "cursor": "pointer",
            "transition": "opacity 0.15s, filter 0.15s",
            "letterSpacing": "0.3px",
            "boxShadow": "0 1px 2px rgba(0,0,0,0.08)"
        }
    }
}