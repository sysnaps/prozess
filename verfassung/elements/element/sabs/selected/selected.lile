{
    "body": {
        "style": {
            "padding": "2px 8px",
            "background": "var(--accent)",
            "color": "#fff",
            "fontWeight": 600,
            "borderRadius": "3px",
            "fontSize": "11px",
            "cursor": "pointer",
            "transition": "background 0.15s, color 0.15s",
            "userSelect": "none",
            "border": "none"
        }
    }
}