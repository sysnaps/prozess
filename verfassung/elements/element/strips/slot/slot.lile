{
    "body": {
        "style": {
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "center",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "var(--text-secondary)",
            "background": "var(--bg-secondary)",
            "borderRadius": 4,
            "border": "1px solid var(--border)",
            "padding": "6px 0",
            "minWidth": 28,
            "minHeight": 20,
            "boxSizing": "border-box"
        }
    }
}