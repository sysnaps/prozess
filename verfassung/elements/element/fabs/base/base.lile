{
    "body": {
        "style": {
            "padding": "6px 14px",
            "border": "none",
            "background": "transparent",
            "color": "var(--text-secondary)",
            "cursor": "pointer",
            "fontSize": "13px",
            "borderRadius": "4px",
            "whiteSpace": "nowrap",
            "transition": "background 0.15s, color 0.15s"
        }
    }
}