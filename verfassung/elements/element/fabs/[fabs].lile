{
    "cap": "print",
    "kind": "print",
    "for": "fab",
    "iddress": "[ci.fabs]",
    "label": "Fabs",
    "default": "ci.fabs.@verfassung",
    "on": {
        "click": [
            {
                "arguments": [
                    "$label"
                ],
                "kind": "effect",
                "effect": [
                    "replace"
                ],
                "value": "$label",
                "target": "!character.vreen.active.fab"
            }
        ]
    }
}