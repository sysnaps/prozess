{
    "body": {
        "style": {
            "padding": "6px 10px",
            "background": "var(--bg-secondary)",
            "border": "1px solid var(--border)",
            "borderRadius": 4,
            "color": "var(--text-primary)",
            "fontSize": 13,
            "fontFamily": "inherit",
            "cursor": "text",
            "flex": 1,
            "minHeight": 28,
            "display": "flex",
            "alignItems": "center",
            "userSelect": "none",
            "transition": "border-color 0.15s ease"
        }
    }
}