{
    "body": {
        "style": {
            "padding": "8px 10px",
            "background": "var(--bg-secondary)",
            "border": "1px solid var(--border)",
            "borderRadius": 4,
            "color": "var(--text-primary)",
            "fontSize": 13,
            "fontFamily": "inherit",
            "outline": "none",
            "resize": "vertical",
            "minHeight": 80,
            "flex": 1
        }
    }
}