{
    "body": {
        "style": {
            "padding": "2px 8px",
            "background": "transparent",
            "border": "none",
            "borderRadius": 3,
            "color": "var(--text-secondary)",
            "fontSize": 10,
            "fontWeight": 600,
            "cursor": "pointer",
            "transition": "background 0.1s, color 0.1s",
            "whiteSpace": "nowrap",
            "textTransform": "uppercase",
            "letterSpacing": "0.4px"
        }
    }
}