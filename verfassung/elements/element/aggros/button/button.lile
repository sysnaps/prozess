{
    "body": {
        "style": {
            "base": {
                "background": "none",
                "border": "none",
                "cursor": "pointer",
                "fontSize": 14,
                "padding": "0 4px",
                "lineHeight": 1,
                "opacity": 0.5
            },
            "remove": {
                "color": "var(--text-secondary)"
            },
            "confirm": {
                "color": "hsl(140, 50%, 60%)",
                "opacity": 0.7
            },
            "dismiss": {
                "color": "var(--text-secondary)"
            }
        }
    }
}