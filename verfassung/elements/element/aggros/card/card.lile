{
    "body": {
        "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": 8,
            "padding": "6px 10px",
            "background": "var(--bg-secondary)",
            "borderRadius": 4,
            "border": "1px solid var(--border)",
            "transition": "opacity 0.15s ease"
        }
    }
}