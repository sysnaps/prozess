{
    "cap": "elob",
    "kind": "bar.fab",
    "iddress": "ci.bar.fab",
    "label": "fabBar",
    "defaults": {
        "standalone": false,
        "style": {
            "display": "flex",
            "alignItems": "center",
            "background": "var(--bg-secondary)",
            "borderBottom": "1px solid var(--border)",
            "padding": "0 12px",
            "gap": "2px",
            "overflow": "visible",
            "height": "6%",
            "position": "relative",
            "zIndex": 100
        }
    },
    "mehr": {
        "bay": [
            {
                "kind": "effect",
                "type": "pointer",
                "iddress": "ci.bar.fab:mehr.bay%1",
                "effect": "each",
                "each": {
                    "array": "!character.vreen.fabs",
                    "filter": [
                        "/fab.show"
                    ],
                    "sort": [
                        "/fab.place"
                    ],
                    "trigger": [],
                    "map": []
                },
                "location": "+bay"
            }
        ]
    }
}