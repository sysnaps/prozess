    "explanation": {
        "for": "scheduler",
        "tences": [
            "the scheduler tells us to what plan a plan belongs to",
            "it has all the current hierarchy options as property keys",
            "a plan can belong to multiple other plans",
            [
                {
                    "if": "a plan in the scheduler is below our hierarchy ",
                    "then": "the plan below us tells us that its fullfilment is required for the advancement of our plan"
                },
                {
                    "if": "a plan in the scheduler is above our hierarchy ",
                    "then": "we are part of that plan above us"
                }
            ]
        ]
    }
}